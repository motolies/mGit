{
  "name": "mgit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm -F @mgit/desktop tauri dev",
    "build": "pnpm -F @mgit/desktop tauri build",
    "tauri": "pnpm -F @mgit/desktop tauri",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:ipc": "cargo test -p mgit-desktop --lib export_bindings"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
