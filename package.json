{
  "name": "mgit",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "CI=true TAURI_BUNDLER_DMG_IGNORE_CI=false pnpm -F @mgit/desktop tauri build",
    "tauri": "pnpm -F @mgit/desktop tauri",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:ipc": "cargo test -p mgit-desktop --lib export_bindings",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:tag": "node scripts/release.mjs tag",
    "release:macos": "node scripts/release.mjs macos",
    "test:release": "node --test scripts/__tests__/release.test.mjs",
    "signing:setup": "swift -suppress-warnings scripts/signing-identity.swift create",
    "signing:status": "swift -suppress-warnings scripts/signing-identity.swift status",
    "signing:export": "swift -suppress-warnings scripts/signing-identity.swift export",
    "signing:import": "swift -suppress-warnings scripts/signing-identity.swift import",
    "signing:verify-backup": "swift -suppress-warnings scripts/signing-identity.swift verify-backup",
    "test:signing": "node --test scripts/signing-tests/signing.test.mjs",
    "release": "bash scripts/release.sh",
    "dev:web": "node scripts/dev.mjs --web",
    "dev:test": "node scripts/dev.mjs --test",
    "test:runtime": "node --test scripts/__tests__/dev.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
